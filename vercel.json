{
  "redirects": [
    {
      "source": "/licznik_view(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/licznik(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|static/|_next/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}