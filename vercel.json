{
  "redirects": [
    {
      "source": "/licznik",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/licznik.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/licznik_view",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/licznik_view.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|static/|_next/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}